# Optional. Defaults to 3001; a busy port stops the server rather than moving it to the next one.
PORT=3001
# Optional, and only behind a reverse proxy: believe X-Forwarded-For from that many proxies (1)
# or from those addresses (loopback), so the rate limit counts visitors, not the proxy. Unset,
# nobody's is believed.
# TRUST_PROXY=1
